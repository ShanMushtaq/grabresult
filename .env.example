# GrabResult example environment configuration.
# Copy to .env and adjust. Never commit real secrets.
# The app runs fine with ALL defaults; only SECRET_KEY should be changed
# for any shared/production deployment.

# Random secret for Flask sessions (generate: python -c "import secrets; print(secrets.token_hex(32))")
GRABRESULT_SECRET_KEY=dev-only-change-me

# Where the SQLite database file lives
GRABRESULT_DB_PATH=./instance/grabresult.db

# Upload / export directories
GRABRESULT_UPLOAD_DIR=./instance/uploads
GRABRESULT_EXPORT_DIR=./instance/exports

# Max upload size in megabytes
GRABRESULT_MAX_UPLOAD_MB=10

# Research politeness / safety limits
GRABRESULT_HTTP_TIMEOUT=20
GRABRESULT_MAX_RETRIES=2
GRABRESULT_RPS=1.0
GRABRESULT_MAX_RECORDS=500
GRABRESULT_MAX_WEBSITE_INSPECT=40

# User-Agent sent to public sources (include contact info for heavy use)
GRABRESULT_USER_AGENT=GrabResult/1.0

# Port for local runs (hosting platforms usually set PORT themselves)
PORT=5000
